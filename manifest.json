{
    "manifest_version": 3,
    "name": "owlEyes",
    "version": "v1",
    "description": "Keep a personal eye on things. Tag usernames, URLs, domains and subreddits with your own labels and colors, and share databases via GitHub gists.",
    "permissions": [
        "storage",
        "contextMenus",
        "alarms",
        "activeTab",
        "scripting"
    ],
    "host_permissions": [
        "<all_urls>",
        "https://gist.githubusercontent.com/*",
        "https://api.github.com/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "popup.html",
        "default_title": "owlEyes",
        "default_icon": "icons/icon128.png"
    },
    "options_ui": {
        "page": "options.html",
        "open_in_tab": true
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["browser-polyfill.js", "content.js"],
            "css": ["content.css"],
            "run_at": "document_idle"
        }
    ],
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}
